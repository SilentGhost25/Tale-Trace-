APP_NAME=TaleTrace
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO
HOST=127.0.0.1
PORT=8000

# ---- OCR Configuration ----
# Tesseract executable (auto-detected if at standard path)
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
# Optional cloud OCR fallback (OCR.space free key: 500 calls/day)
OCR_SPACE_API_KEY=

# ---- Groq AI Configuration ----
# You can provide a single GROQ_API_KEY, or separate keys for each engine
GROQ_API_KEY=replace-me
GROQ_API_KEY_1=   # Merge Engine (defaults to GROQ_API_KEY if unset)
GROQ_API_KEY_2=   # Meaning Engine (defaults to GROQ_API_KEY if unset)
GROQ_API_KEY_3=   # Learning Engine (defaults to GROQ_API_KEY if unset)

GROQ_MODEL=openai/gpt-oss-120b
GROQ_FAST_MODEL=openai/gpt-oss-20b

# ---- Book Domain Context ----
BOOK_TITLE=Septopus: Trouble on the High Cs
BOOK_AUTHOR=Jyotin Goel

# ---- ESP32 DevKit Endpoints ----
ESP32_BUTTONS_URL=http://192.168.1.26:8080/buttons
ESP32_DISPLAY_URL=http://192.168.1.26:8080/display
ESP32_SERIAL_PORT=   # Leave blank to auto-detect USB COM port (e.g. COM5 or COM10)
ESP32_BAUD_RATE=115200

# ---- Offline Text-to-Speech Engine ----
AUDIO_PROVIDER=offline

# ---- Logitech C270 HD WebCam ----
WEBCAM_DEVICE_INDEX=0
WEBCAM_WIDTH=1280
WEBCAM_HEIGHT=720
